# GPU Hub reads secrets from its dashboard-managed 0600 JSON files by default.
# These optional variables are reserved for deployment wrappers.
GPU_HUB_HOST=0.0.0.0
GPU_HUB_PORT=8778
GPU_HUB_LOCAL_BRIDGE_PORT=8776
# Optional public callback used by Kaggle kernels. Status polling still works
# when this is omitted, but tunnel registration can take longer.
GPU_HUB_WEBHOOK_HOST=https://your-gpu-hub-callback.example
GPU_HUB_TAILSCALE_IP=
GPU_HUB_KAGGLE_BIN=/usr/local/bin/kaggle
