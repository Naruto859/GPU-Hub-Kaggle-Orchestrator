# GPU Hub reads secrets from its dashboard-managed 0600 JSON files by default.
# These optional variables are reserved for deployment wrappers.
GPU_HUB_HOST=0.0.0.0
GPU_HUB_PORT=8778
GPU_HUB_LOCAL_BRIDGE_PORT=8776
# Optional public callback used by Kaggle kernels. Status polling still works
# when this is omitted, but tunnel registration can take longer.
GPU_HUB_WEBHOOK_HOST=https://your-gpu-hub-callback.example
GPU_HUB_TAILSCALE_IP=
GPU_HUB_KAGGLE_BIN=/usr/local/bin/kaggle

# Recommended transport when Kaggle cancels inbound tunnel processes. This
# listener exposes only token-authenticated worker relay routes.
GPU_HUB_RELAY_BIND=
GPU_HUB_RELAY_PORT=8777
GPU_HUB_RELAY_URL=http://your-public-vps-host:8777

# Legacy transport fallbacks used when the relay is not configured.
GPU_HUB_REVERSE_SSH_HOST=
GPU_HUB_REVERSE_SSH_USER=root
GPU_HUB_REVERSE_SSH_PORT=22
GPU_HUB_REVERSE_SSH_AUTHORIZED_KEYS=/root/.ssh/authorized_keys
